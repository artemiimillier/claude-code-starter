# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_32_plus_chars_openssl_rand_hex_32
ENCRYPTION_KEY=replace_with_32_chars_openssl_rand_hex_16

# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3308
DB_USER=app
DB_PASS=apppass
DB_NAME=second_brain

# ─── OpenAI (для Q&A чата) ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Telegram (GramJS аккаунт) ────────────────────────────────────────────────
# Получить на https://my.telegram.org → API Development Tools
TG_API_ID=12345678
TG_API_HASH=abcdef1234567890abcdef1234567890

# ─── Obsidian Vault ───────────────────────────────────────────────────────────
# Абсолютный путь к папке vault (по умолчанию ../vault относительно web/)
# VAULT_PATH=/home/user/second-brain-vault

# ─── Production (опционально) ─────────────────────────────────────────────────
# NEXT_PUBLIC_URL=https://brain.example.com
